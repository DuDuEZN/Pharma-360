# Production configuration template only.
# Do not store production secrets in this repository. Supply all values through
# your deployment secret manager or CI/CD environment variables.
# Rotate credentials that were previously committed in this file.
APP_NAME=Pharma-360
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=SET_VIA_SECRET_MANAGER
POSTGRES_HOST=pharma360-db
POSTGRES_PORT=5432
POSTGRES_DB=pharma360_prod
POSTGRES_USER=SET_VIA_SECRET_MANAGER
POSTGRES_PASSWORD=SET_VIA_SECRET_MANAGER
JWT_SECRET=SET_VIA_SECRET_MANAGER
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=https://your-pharmacy-domain.example
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
IA_HOST=0.0.0.0
IA_PORT=8001
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443
