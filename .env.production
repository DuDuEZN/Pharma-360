# ===========================================
# Configuration Environment - Pharma 360 PRODUCTION
# ===========================================
# ID Tâche: QA-016
# Responsable: QA/DevOps
# Statut: EN COURS
# ===========================================

# ===========================================
# Configuration Générale
# ===========================================
APP_NAME=Pharma-360
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=pharma360_prod_secret_key_2025_64chars_a1b2c3d4e5f6g7h8

# ===========================================
# Base de Données PostgreSQL (Production)
# ===========================================
POSTGRES_HOST=pharma360-db
POSTGRES_PORT=5433
POSTGRES_DB=pharma360_prod
POSTGRES_USER=pharma_admin
POSTGRES_PASSWORD=Pharma360_Prod_Pass_2025_Secure_Key
POSTGRES_TEST_DB=pharma360_test
POSTGRES_ROOT_PASSWORD=Pharma360_Root_Pass_2025_Secure

# ===========================================
# Backend (FastAPI)
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://pharma360-backend:8000
JWT_SECRET=pharma360_jwt_secret_prod_2025_64chars_x1y2z3a4b5c6d7e8f
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS="http://localhost,http://pharma360-frontend,http://localhost:80"

# ===========================================
# Frontend (React)
# ===========================================
FRONTEND_HOST=pharma360-frontend
FRONTEND_PORT=80
FRONTEND_URL=http://localhost:80

# ===========================================
# IA (OCR/Analytics)
# ===========================================
IA_HOST=pharma360-ia
IA_PORT=8001
IA_URL=http://pharma360-ia:8001

# ===========================================
# Docker
# ===========================================
DOCKER_REGISTRY=localhost:5000
COMPOSE_PROJECT_NAME=pharma360_prod

# ===========================================
# Nginx (Reverse Proxy)
# ===========================================
NGINX_HOST=localhost
NGINX_PORT=80
NGINX_SSL_PORT=443

# ===========================================
# Sauvegardes Automatiques
# ===========================================
BACKUP_DIR=/var/backups/pharma360
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/pharma360/app.log
MAX_LOG_FILES=10
MAX_LOG_FILE_SIZE=50MB

# ===========================================
# Performance (Production Optimized)
# ===========================================
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=1GB

BACKEND_WORKERS=8
BACKEND_MAX_REQUESTS=5000
BACKEND_TIMEOUT=60

# ===========================================
# Sécurité (Production)
# ===========================================
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=120

SESSION_TIMEOUT_MINUTES=60
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_SPECIAL=true
