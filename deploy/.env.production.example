# ============================================================
# Pharma 360 — Variables d'environnement PRODUCTION
# Copier ce fichier en .env.production et adapter les valeurs.
# NE JAMAIS commiter .env.production (contient des secrets).
# ============================================================

# --- Application ---
APP_NAME=Pharma-360
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGER_PAR_64_CARACTERES_ALEATOIRES

# --- Base de données PostgreSQL ---
POSTGRES_DB=pharma360_prod
POSTGRES_USER=pharma_admin
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE_FORT
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=1GB

# --- JWT ---
JWT_SECRET=CHANGER_PAR_64_CARACTERES_ALEATOIRES
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Réseau / CORS ---
CORS_ORIGINS=https://pharma.votre-domaine.com

# --- Backend ---
BACKEND_WORKERS=8
BACKEND_MAX_REQUESTS=5000
BACKEND_TIMEOUT=60
LOG_LEVEL=INFO

# --- Frontend ---
NODE_ENV=production
FRONTEND_PORT=80

# --- (Optionnel) Coexistence : ports alternatifs ---
# Si un autre logiciel occupe 80/443, décommenter et adapter :
# PHARMA_HTTP_PORT=8080
# PHARMA_HTTPS_PORT=8443
# PHARMA_BACKEND_PORT=18000
# PHARMA_IA_PORT=18001
