# ===========================================
# Pharma 360 Environment Configuration
# ===========================================
# Copy this file to .env and customize for your environment

# Application Settings
APP_NAME=Pharma-360
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changer_par_une_cle_secrete_tres_longue_et_aleatoire

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# IA Service Configuration
IA_HOST=0.0.0.0
IA_PORT=8001

# Frontend Configuration
FRONTEND_PORT=3000
NODE_ENV=development

# Nginx Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443

# PostgreSQL Database Configuration
POSTGRES_HOST=pharma360-db
POSTGRES_PORT=5432
POSTGRES_DB=pharma360_dev
POSTGRES_USER=pharma_user
POSTGRES_PASSWORD=pharma_pass_2025

# JWT Authentication
JWT_SECRET=changer_par_une_cle_jwt_secrete_tres_longue_et_aleatoire
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=*

# Logging Configuration
LOG_LEVEL=INFO

# Tesseract OCR Configuration
TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata

# Docker Network
DOCKER_NETWORK=pharma360-network
