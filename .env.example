# ===========================================
# Configuration Environment - Pharma 360°
# ===========================================
# ID Tâche: QA-004
# Responsable: QA/DevOps
# Statut: TERMINÉ
# Instructions: Copier ce fichier en .env et adapter les valeurs
# ===========================================

# ===========================================
# Configuration Générale
# ===========================================
APP_NAME=Pharma-360
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changer_par_une_cle_secrete_aleatoire_64_caracteres

# ===========================================
# Base de Données PostgreSQL
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharma360_dev
POSTGRES_USER=pharma_user
POSTGRES_PASSWORD=changer_par_un_mot_de_passe_secure
POSTGRES_TEST_DB=pharma360_test
POSTGRES_ROOT_PASSWORD=changer_par_un_mot_de_passe_secure

# ===========================================
# Backend (FastAPI)
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
JWT_SECRET=changer_par_une_cle_jwt_secrete_aleatoire_64_caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS="http://localhost:3000,http://localhost:80"

# ===========================================
# Frontend (React)
# ===========================================
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ===========================================
# IA (OCR/Analytics)
# ===========================================
IA_HOST=localhost
IA_PORT=8001
IA_URL=http://localhost:8001

# ===========================================
# Docker
# ===========================================
DOCKER_REGISTRY=localhost:5000
COMPOSE_PROJECT_NAME=pharma360

# ===========================================
# Nginx (Reverse Proxy)
# ===========================================
NGINX_HOST=localhost
NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_SSL_CERT=/etc/nginx/ssl/cert.pem
NGINX_SSL_KEY=/etc/nginx/ssl/key.pem

# ===========================================
# Sauvegardes Automatiques
# ===========================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"  # Tous les jours à 2h

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
MAX_LOG_FILES=5
MAX_LOG_FILE_SIZE=10MB

# ===========================================
# Performance
# ===========================================
# PostgreSQL
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB

# Backend
BACKEND_WORKERS=4
BACKEND_MAX_REQUESTS=1000
BACKEND_TIMEOUT=30

# ===========================================
# Sécurité
# ===========================================
# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Session
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_SPECIAL=true

# ===========================================
# Email (pour notifications futures)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=your_email@gmail.com

# ===========================================
# Notes
# ===========================================
# 1. Pour générer des clés secrètes:
#    - openssl rand -hex 64 (pour APP_SECRET_KEY et JWT_SECRET)
#    - openssl rand -base64 32 (pour POSTGRES_PASSWORD)
#
# 2. Pour les mots de passe PostgreSQL:
#    - Utiliser des caractères spéciaux, majuscules, minuscules et chiffres
#    - Minimum 16 caractères pour la production
#
# 3. En production, utiliser des variables d'environnement externes
#    (AWS Secrets Manager, HashiCorp Vault, etc.)
#
# 4. Ne jamais commiter le fichier .env dans Git
#    (il est dans .gitignore)
