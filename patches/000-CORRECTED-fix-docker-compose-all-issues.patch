From: Pharma360 QA Team
Subject: [PATCH 000] Fix all Docker Compose issues - Complete fix
Date: 2026-11-01

This is a CORRECTED patch that fixes ALL issues in docker-compose.yml:
1. Remove backup-db.sh from PostgreSQL initdb.d (causes dependency errors)
2. Fix frontend healthcheck: wget -> curl (not available in nginx-unprivileged)
3. Fix nginx healthcheck: wget -> curl (not available in nginx:alpine)
4. Fix frontend port mapping: 8080 -> 8080 (was 3000:80, but frontend serves on 8080)

---
 docker/docker-compose.yml | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/docker/docker-compose.yml b/docker/docker-compose.yml
index abc1234..def5678 100644
--- a/docker/docker-compose.yml
+++ b/docker/docker-compose.yml
@@ -26,7 +26,6 @@ services:
     volumes:
       - pharma360-db-data:/var/lib/postgresql/data
       - ./scripts/init-db.sql:/docker-entrypoint-initdb.d/init-db.sql
-      - ./scripts/backup-db.sh:/docker-entrypoint-initdb.d/backup-db.sh
     ports:
       - "${POSTGRES_PORT:-5432}:5432"
     networks:
@@ -93,11 +92,11 @@ services:
     depends_on:
       pharma360-backend:
         condition: service_healthy
     ports:
-      - "${FRONTEND_PORT:-3000}:80"
+      - "${FRONTEND_PORT:-8080}:8080"
     networks:
       - pharma360-network
     healthcheck:
-      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost/"]
+      test: ["CMD-SHELL", "curl -f http://localhost:8080/ || exit 1"]
       interval: 30s
       timeout: 10s
       retries: 3
@@ -169,7 +168,7 @@ services:
       - ./frontend/dist:/usr/share/nginx/html:ro
     healthcheck:
-      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost/"]
+      test: ["CMD-SHELL", "curl -f http://localhost/ || exit 1"]
       interval: 30s
       timeout: 10s
       retries: 3
---
To apply this patch:
  cd /workspace/github__DuDuEZN__Pharma-360
  patch -p1 < patches/000-CORRECTED-fix-docker-compose-all-issues.patch

OR manually apply:
  1. Remove line 29: - ./scripts/backup-db.sh:/docker-entrypoint-initdb.d/backup-db.sh
  2. Change line 96: - "${FRONTEND_PORT:-3000}:80" -> - "${FRONTEND_PORT:-8080}:8080"
  3. Change line 100: test: ["CMD", "wget", ...] -> test: ["CMD-SHELL", "curl -f http://localhost:8080/ || exit 1"]
  4. Change line 172: test: ["CMD", "wget", ...] -> test: ["CMD-SHELL", "curl -f http://localhost/ || exit 1"]
