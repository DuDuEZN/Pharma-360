From: Pharma360 QA Team
Subject: [PATCH 002/05] Migrate frontend tests from Jest to Vitest
Date: 2026-11-01

This patch migrates all frontend tests from Jest syntax to Vitest syntax.
All 4 test files are updated to work with Vitest.

---
 frontend/tests/apiService.test.js | 15 ++++++++-------
 frontend/tests/components.test.js | 12 ++++++------
 frontend/tests/hooks.test.js    | 10 ++++++----
 frontend/tests/pages.test.js    |  8 ++++++--
 4 files changed, 26 insertions(+), 19 deletions(-)

diff --git a/frontend/tests/apiService.test.js b/frontend/tests/apiService.test.js
index abc1234..def5678 100644
--- a/frontend/tests/apiService.test.js
+++ b/frontend/tests/apiService.test.js
@@ -1,12 +1,15 @@
 /**
  * @jest-environment node
  * Frontend API Service Tests
  * QA-007: Tests Frontend (Jest + React Testing Library)
  */
 
-const { api } = require('../src/services/api');
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
+import { api } from '../src/services/api';
 
 // Mock fetch globally
-beforeEach(() => {
-  global.fetch = jest.fn();
+beforeEach(() => {
+  global.fetch = vi.fn();
 });
 
-afterEach(() => {
-  jest.clearAllMocks();
+afterEach(() => {
+  vi.clearAllMocks();
 });
 
@@ -25,7 +28,7 @@ describe('API Service', () => {
     it('should make GET request with correct URL', async () => {
       global.fetch.mockResolvedValue({
-        json: jest.fn().mockResolvedValue({ data: 'test' })
+        json: vi.fn().mockResolvedValue({ data: 'test' })
       });
 
       const result = await api.get('/test');
@@ -35,7 +38,7 @@ describe('API Service', () => {
     it('should handle errors', async () => {
       global.fetch.mockRejectedValue(new Error('Network error'));
 
-      await expect(api.get('/test')).rejects.toThrow('Network error');
+      await expect(api.get('/test')).rejects.toThrow('Network error');
     });
   });
 });
@@ -43,7 +46,7 @@ describe('API Service', () => {
   describe('POST requests', () => {
     it('should make POST request with data', async () => {
       global.fetch.mockResolvedValue({
-        json: jest.fn().mockResolvedValue({ data: 'created' })
+        json: vi.fn().mockResolvedValue({ data: 'created' })
       });
 
       const result = await api.post('/test', { name: 'test' });
@@ -53,7 +56,7 @@ describe('API Service', () => {
     it('should handle POST errors', async () => {
       global.fetch.mockRejectedValue(new Error('Create failed'));
 
-      await expect(api.post('/test', {})).rejects.toThrow('Create failed');
+      await expect(api.post('/test', {})).rejects.toThrow('Create failed');
     });
   });
 });

